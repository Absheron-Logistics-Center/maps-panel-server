# Copy to .env (Map-Panel/.env) on the SERVER, and set the same MONGODB_URI in Vercel > Settings > Environment Variables.
PORT=4000
BASE_PATH=/maps-panel
SERVE_FRONTEND=1
CORS_ORIGIN=*
JWT_SECRET=change-me-long-random

# THE ONE DATABASE shared by Vercel and the server (full connection string):
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/mappanel?retryWrites=true&w=majority
MONGODB_DB=mappanel

# AI assistant (optional)
GEMINI_API_KEY=
AI_PROVIDER=gemini
GROQ_API_KEY=
OPENROUTER_API_KEY=

# GITHUB_* are no longer used. Data never goes to GitHub, so saving no longer triggers Vercel redeploys.
