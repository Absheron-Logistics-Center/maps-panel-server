# --- Self-hosted deployment on your own Windows server (172.25.60.81) ---
# Copy this to backend/.env (or project-root .env) and fill in JWT_SECRET.

PORT=4000

# Serves the app at http://172.25.60.81/maps-panel instead of the domain root.
# Leave BASE_PATH empty for a normal root-domain deploy (e.g. Vercel).
BASE_PATH=/maps-panel

# Makes this Node process also serve the built frontend (frontend/dist),
# so IIS/Apache only has to reverse-proxy one URL to one port.
SERVE_FRONTEND=1

# Pick a real random string here (any long random text works).
JWT_SECRET=change-this-to-something-long-and-random

# --- Fill these in with the SAME values Vercel uses (Vercel Project ---
# --- Settings > Environment Variables) so this server and Vercel share ---
# --- one MongoDB + one GitHub repo instead of being two separate data  ---
# --- islands. This is what actually fixes the "data doesn't match     ---
# --- between server and Vercel" problem — it's not a code bug, it's   ---
# --- that this server was never pointed at the same backends.         ---
#
# Diagrams live in Mongo; PDFs/templates (files) live in GitHub. The
# local data/ folder still gets written to as an auto-save mirror either
# way — it just stops being the only copy once these are set.
#
# After filling these in and restarting, run ONCE from backend/:
#     node scripts/sync-data.mjs --dry-run   (see what would change)
#     node scripts/sync-data.mjs             (apply it)
# This pulls in anything only on Vercel/GitHub/Mongo, and pushes up
# anything that only exists in this server's local data/ folder —
# additive only, nothing gets overwritten.
MONGODB_URI=
GITHUB_TOKEN=
GITHUB_OWNER=
GITHUB_REPO=

# Same-origin once IIS/Apache proxies /maps-panel/* here, so this can stay '*'.
CORS_ORIGIN=*
